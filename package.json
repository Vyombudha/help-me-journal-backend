{
  "name": "journaling-app",
  "type": "module",
  "scripts": {
    "db:local": "wrangler d1 migrations apply journal-db --local",
    "db:remote": "wrangler d1 migrations apply journal-db --remote",
    "db:gen": "drizzle-kit generate",
    "dev": "wrangler dev",
    "test" : "vitest run",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@clerk/hono": "^0.1.98",
    "@hono/standard-validator": "^0.4.1",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.17",
    "hono-rate-limiter": "^0.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "to": "^0.2.9",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
