{
  "name": "journaling-app",
  "type": "module",
  "scripts": {
    "db:local": "wrangler d1 migrations apply journal-db --local",
    "db:remote": "wrangler d1 migrations apply journal-db --remote",
    "db:gen": "drizzle-kit generate",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@clerk/hono": "^0.1.95",
    "@hono/standard-validator": "^0.4.1",
    "drizzle-orm": "^0.44",
    "hono": "^4.13.14",
    "hono-rate-limiter": "^0.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31",
    "wrangler": "^4.110.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
